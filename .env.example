# Public QQ Connect app id. This is safe to expose to the browser.
QQ_APP_ID=1904930904
QQ_CALLBACK_URL=https://hearts.duanap.cn/qq-callback.html

# Server-side session settings.
AUTH_COOKIE_NAME=hearts_sid
AUTH_SESSION_TTL_MS=2592000000

# Primary persistence. Node.js 22.13+ is required for the built-in SQLite driver.
DATA_BACKEND=sqlite
DATABASE_FILE=/www/wwwroot/duanap/apps/hearts/hearts-by-duanap/data/hearts.sqlite

# Admin API bootstrap. Set the password only in the server environment.
# The bootstrap account is created only when the username does not already exist.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_ROLE=super_admin
ADMIN_SESSION_TTL_MS=28800000

# Keep QQ App Key out of the repository and frontend bundle.
# Use it only if you later switch to a server-side OAuth code flow.
