{
  "name": "gongzhu-by-duanap",
  "version": "0.1.2",
  "description": "拱猪联机版：gongzhu-v1 规则、秘密亮牌、AI 补位与断线重连",
  "main": "server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:client": "vite --host 127.0.0.1",
    "build:client": "vite build",
    "preview:client": "vite preview --host 127.0.0.1",
    "start": "node server.js",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/gongzhu-smoke.spec.js",
    "test": "node --test src/server/*.test.js src/server/games/gongzhu/*.test.js",
    "start:prod": "pm2 start ecosystem.config.js",
    "reload:prod": "pm2 restart gongzhu --update-env"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
